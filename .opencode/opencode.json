{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "playwright": {
            "type": "local",
            "command": ["npx", "@playwright/mcp@latest"],
            "enabled": true
        }
    },
    "provider": {
        "litellm": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "LiteLLM",
            "options": {
                "baseURL": "https://gateway.vitruvi.cc/v1"
            },
            "models": {
                "opus-4.8": {
                    "name": "Opus 4.8",
                    "modalities": { "input": ["text", "image"], "output": ["text"] }
                },
                "sonnet-5": {
                    "name": "Sonnet 5",
                    "modalities": { "input": ["text", "image"], "output": ["text"] }
                },
                "haiku-4.5": {
                    "name": "Haiku",
                    "modalities": { "input": ["text", "image"], "output": ["text"] }
                },
                "gpt-6.1-sol": {
                    "name": "GPT Sol 6.1",
                    "modalities": { "input": ["text", "image"], "output": ["text"] },
                    "variants": {
                        "none": {
                            "reasoningEffort": "none"
                        },
                        "low": {
                            "reasoningEffort": "low"
                        },
                        "medium": {
                            "reasoningEffort": "medium"
                        },
                        "high": {
                            "reasoningEffort": "high"
                        },
                        "xhigh": {
                            "reasoningEffort": "xhigh"
                        }
                    },
                    "cost": {
                        "input": 2.2,
                        "output": 11,
                        "cache": {
                            "read": 0.11,
                            "write": 2.75
                        }
                    }
                },
                "gpt-6-luna": {
                    "name": "GPT luna 6",
                    "modalities": { "input": ["text", "image"], "output": ["text"] },
                    "variants": {
                        "none": {
                            "reasoningEffort": "none"
                        },
                        "low": {
                            "reasoningEffort": "low"
                        },
                        "medium": {
                            "reasoningEffort": "medium"
                        },
                        "high": {
                            "reasoningEffort": "high"
                        },
                        "xhigh": {
                            "reasoningEffort": "xhigh"
                        }
                    },
                    "cost": {
                        "input": 0.11,
                        "output": 0.55,
                        "cache": {
                            "read": 0.011,
                            "write": 0.1375
                        }
                    }
                },
                "gemini-3.1-pro": {
                    "name": "Gemini 3.1 Pro",
                    "modalities": { "input": ["text", "image"], "output": ["text"] },
                    "variants": {
                        "low": {
                            "reasoningEffort": "low"
                        },
                        "high": {
                            "reasoningEffort": "high"
                        }
                    },
                    "cost": {
                        "input": 2,
                        "output": 12,
                        "cache": {
                            "read": 0.2
                        }
                    }
                }
            }
        }
    }
}
